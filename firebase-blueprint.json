{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account profile data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "username", "email"]
    },
    "DownloadRecord": {
      "title": "Download Record",
      "description": "User download history record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "platform": { "type": "string" },
        "title": { "type": "string" },
        "format": { "type": "string" },
        "sizeMB": { "type": "number" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "userId", "platform", "title"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles collection"
    },
    "/users/{userId}/downloads/{downloadId}": {
      "schema": "DownloadRecord",
      "description": "User download history"
    }
  }
}
